{
  "name": "@workspace/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm --filter @workspace/database build && tsc-watch --onSuccess \"node --env-file=../../.env dist/index.js\"",
    "format": "prettier --write \"**/*.ts\"",
    "lint": "eslint",
    "start": "node --env-file=../../.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@workspace/database": "workspace:*",
    "better-auth": "1.7.4",
    "cors": "2.8.5",
    "express": "5.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@swc/core": "1.13.5",
    "@tanstack/eslint-config": "0.3.2",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/node": "24.5.2",
    "@types/supertest": "6.0.3",
    "eslint": "9.36.0",
    "supertest": "7.1.4",
    "tsc-watch": "7.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.0"
  }
}
