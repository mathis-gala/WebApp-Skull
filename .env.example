# Local PostgreSQL container
POSTGRES_DB=webapp_skull
POSTGRES_USER=webapp_skull
POSTGRES_PASSWORD=webapp_skull_dev
POSTGRES_PORT=5433

# Backend
API_PORT=3001
DATABASE_URL=postgresql://webapp_skull:webapp_skull_dev@localhost:5433/webapp_skull
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# Frontend, safe to expose to browser
VITE_API_URL=http://localhost:3001
